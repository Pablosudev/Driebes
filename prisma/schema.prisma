// Esquema de Prisma para la API del Ayuntamiento.
// Prisma controla el esquema de la base de datos y sus migraciones.
// Modelo basado en docs/0001-diseno-api.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// BOOKINGS (Reservas del local municipal)
// ─────────────────────────────────────────

// 'free' (libre) es un estado calculado que en la práctica no se persiste,
// pero se incluye para reflejar el dominio completo (BookingState en el código).
enum BookingState {
  free
  pending
  reserved
}

model Booking {
  id         Int          @id @default(autoincrement())
  name       String
  phone      String
  startDate  DateTime     @map("start_date")
  endDate    DateTime     @map("end_date")
  state      BookingState @default(pending)
  notes      String?      @db.Text
  createDate DateTime     @default(now()) @map("create_date")

  @@index([startDate, endDate])
  @@map("bookings")
}

// ─────────────────────────────────────────
// NEWS (Noticias del ayuntamiento)
// ─────────────────────────────────────────

model News {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  image       String?  @db.VarChar(500)
  uploadDate  DateTime @default(now()) @map("upload_date")

  @@map("news")
}

// ─────────────────────────────────────────
// EVENTS (Eventos del ayuntamiento)
// ─────────────────────────────────────────

// Los valores se guardan ya en español: es el texto que se muestra al usuario
// y no hay intención de traducir la aplicación, así que no existe capa de
// traducción en el código.
enum Category {
  Deportivo
  Festivo
  Religioso
  Otro
}

model Event {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @db.Text
  image        String?  @db.VarChar(500)
  creationDate DateTime @default(now()) @map("creation_date")
  eventDate    DateTime @map("event_date")
  category     Category

  @@map("events")
}

// ─────────────────────────────────────────
// USERS (Administradores del ayuntamiento)
// ─────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createDate   DateTime @default(now()) @map("create_date")

  @@map("users")
}

// ─────────────────────────────────────────
// JOBS (Ofertas de trabajo)
// ─────────────────────────────────────────

model Job {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @db.Text
  requirements String   @db.Text
  companyName  String   @map("company_name")
  phone        String?
  email        String?
  createDate   DateTime @default(now()) @map("create_date")

  @@map("jobs")
}
