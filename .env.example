# Configuración de conexión a MySQL para Prisma.
# Copia este fichero a .env y ajusta los valores para tu instancia local.
# prisma.config.ts carga este .env e inyecta DATABASE_URL en el datasource.

DATABASE_URL="mysql://usuario:password@localhost:3306/api_ayto"

# Implementación de persistencia: "prisma" usa MySQL; cualquier otro valor
# (o ausencia) usa los repositorios en memoria.
PERSISTENCE=prisma
